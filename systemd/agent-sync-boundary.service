[Unit]
Description=Sync of agent configs at login and logout
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Login: fetch what was done on another machine
ExecStart=%h/.agent-sync/bin/agent-sync.sh pull
ExecStart=%h/.agent-sync/bin/history-sync.sh
# Shutdown: push your own work
ExecStop=%h/.agent-sync/bin/agent-sync.sh sync
ExecStop=%h/.agent-sync/bin/history-sync.sh
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=default.target
