# Copy to agent-sync.env and edit, or run: bin/agent-sync.sh init
# Read by bin/lib/project-env.sh (scripts, hooks) and by `init` (rendering text under store/).
# Real environment variables override this file.
#
# A value equal to the one shipped here counts as "not set" for `init`, so replace every value
# you need. The comment on the right says what to put there; the README walks through a made-up
# project called "acme".

PROJECT_NAME=myproject                 # short slug used in hook/skill names and labels; lowercase, no spaces (acme)
PROJECT_ROOT=/home/me/myproject       # folder holding the project's git checkouts, or the single repo itself (/home/me/acme)
PROJECT_GIT_ORG=myorg                  # GitHub org/owner for gh search and PR links (acme-inc)
#PROJECT_BASE_BRANCH=                  # default: the branch behind origin/HEAD, otherwise main
SYNC_SERVER=                           # ssh alias of your home/team server; empty = no history sync, no remote checks
USER_LANGUAGE=                         # your chat language for long answers; one word (English, Polish, ...); required by init
STAND_DB_HOST=                         # LAN host of the shared dev DBs for the local stand; empty = no LAN mode

# Derived when unset (uncomment only to override):
#PROJECT_CREDS_DIR=/home/me/myproject-creds    # default: ${PROJECT_ROOT}-creds
#HISTORY_REMOTE=myserver:agent-history/claude   # default: ${SYNC_SERVER}:agent-history/claude, empty without a server
